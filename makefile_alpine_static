CXX      = g++
CXXFLAGS = -O2 -Wall -pedantic -flto
LDFLAGS  = -static -flto
LDLIBS   = $(shell pkg-config --static --libs libcurl)

TARGET = otelfwd
OBJS   = otelfwd.o simple_wal.o

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)

otelfwd.o: otelfwd.cpp push_status.hpp push_failover.hpp otlp_protobuf.hpp log_line.hpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

simple_wal.o: simple_wal.cpp simple_wal.hpp log_line.hpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(TARGET) $(OBJS)

